# Server Configuration
NODE_ENV=development
PORT=8080

# Widget Server Configuration
WIDGET_PORT=4444
# Port for widget dev server and production serving (default: 4444)

# Logging
LOG_LEVEL=info
# Options: fatal, error, warn, info, debug, trace

# CORS (for development)
CORS_ORIGIN=*
# In production, set to your specific domain

# Public base URL for widget assets - required in production, optional in development
# Dev: `npm run dev` serves widgets straight from the Vite dev server (no build
# step, HMR everywhere). Hosted clients such as claude.ai and ChatGPT load the
# widget from inside an https sandbox, so they need a public https tunnel to
# the widget dev server (port 4444) here, e.g. a cloudflared quick tunnel or a
# second `ssh -R 0 pom.run` session: BASE_URL=https://widgets.first-wallaby-240.pom.run
# Local hosts (MCP inspectors, desktop apps) can leave it unset and use localhost.
# Production: your CDN/static host, e.g. BASE_URL=https://echo-ui.maisonlab.dev
# BASE_URL=

# Build Configuration
# BUILD_CONCURRENCY=4
# Number of parallel widget builds (default: CPU count / 2)

# Serve fully inlined widget HTML (built by a watch build) instead of live
# dev-server modules. `npm run dev:inline` sets this. Only needed for a host
# that cannot reach your widget dev server tunnel.
# INLINE_DEV_MODE=true
